---
/**
 * Cierre: agendar una demo por correo, o ingresar al panel si el estudio ya es
 * cliente. Sin formularios que no envían: un formulario muerto es exactamente
 * la señal de sitio en construcción que un revisor penaliza.
 */
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import LogIn from '@lucide/astro/icons/log-in';
import Mail from '@lucide/astro/icons/mail';
import { cta, empresa } from '../../content/landing';
import Section from '../ui/Section.astro';
import Reveal from '../ui/Reveal.astro';
import GlowBlob from '../ui/GlowBlob.astro';
import GridBackdrop from '../ui/GridBackdrop.astro';
import MovementHeader from '../ui/MovementHeader.astro';
import { buttonStyles } from '../ui/buttonStyles';

interface Props {
  folio: string;
}
const { folio } = Astro.props;

const mailto = empresa.contacto
  ? `mailto:${empresa.contacto}?subject=${encodeURIComponent(cta.demo.asunto)}`
  : null;
---

<Section id="contacto" folio={folio} rhythm="statement" class="overflow-hidden" labelledby="contacto-titulo">
  <Fragment slot="fondo">
    <GridBackdrop class="[mask-image:radial-gradient(70%_60%_at_50%_100%,#000,transparent)]" />
    <GlowBlob class="bottom-[-16rem] left-1/2 h-[30rem] w-[56rem] -translate-x-1/2" />
  </Fragment>

  <MovementHeader id="contacto-titulo" eyebrow={cta.eyebrow} title={cta.title} titleTail={cta.titleTail} lead={cta.lead} />

  <div class="mt-14 grid gap-6 lg:grid-cols-2">
    <Reveal>
      <div class="glass flex h-full flex-col rounded-3xl p-7 shadow-[0_40px_120px_-60px_rgba(0,0,0,0.9)] sm:p-8">
        <h3 class="font-display text-2xl font-semibold text-cream">{cta.demo.titulo}</h3>
        <p class="mt-4 flex-1 text-[0.9375rem] text-muted">{cta.demo.detalle}</p>
        {
          mailto && empresa.contacto && (
            <>
              <a href={mailto} class={buttonStyles({ size: 'lg', className: 'mt-7 w-full' })}>
                <Mail size={16} aria-hidden="true" />
                {cta.demo.boton}
              </a>
              <p class="mt-3 text-center font-mono text-[0.8125rem] text-muted">{empresa.contacto}</p>
            </>
          )
        }
      </div>
    </Reveal>

    <Reveal delay={60}>
      <div class="flex h-full flex-col rounded-3xl border border-line bg-ink-2/60 p-7 sm:p-8">
        <h3 class="font-display text-2xl font-semibold text-cream">{cta.clientes.titulo}</h3>
        <p class="mt-4 flex-1 text-[0.9375rem] text-muted">{cta.clientes.detalle}</p>
        <a href={empresa.app} class={buttonStyles({ variant: 'secondary', size: 'lg', className: 'mt-7 w-full' })}>
          <LogIn size={16} aria-hidden="true" />
          {cta.clientes.boton}
          <ArrowUpRight size={15} aria-hidden="true" />
        </a>
        <p class="mt-3 text-center font-mono text-[0.8125rem] text-muted">{new URL(empresa.app).host}</p>
      </div>
    </Reveal>
  </div>
</Section>
