---
/**
 * Pie con la identidad legal de la empresa. Solo se muestran los datos que
 * existen: un campo vacío no se reemplaza por un marcador.
 */
import { empresa, footer } from '../../content/landing';
import Wordmark from '../ui/Wordmark.astro';

type Dato = { rotulo: string; valor: string | null };

const legales = ([
  { rotulo: footer.razonSocial, valor: empresa.razonSocial },
  { rotulo: footer.rut, valor: empresa.rut },
  { rotulo: footer.domicilio, valor: empresa.domicilio },
] as Dato[]).filter((l): l is { rotulo: string; valor: string } => Boolean(l.valor));
---

<footer class="border-t border-line bg-ink-2/40">
  <div class="mx-auto max-w-[76rem] px-6 py-14 sm:px-8 lg:px-10">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.4fr)_repeat(2,minmax(0,0.8fr))]">
      <div>
        <Wordmark />
        <p class="mt-4 max-w-xs text-sm text-muted">{empresa.descriptor}.</p>
        {
          empresa.contacto && (
            <p class="mt-5 text-sm">
              <span class="text-muted">{footer.contacto}: </span>
              <a href={`mailto:${empresa.contacto}`} class="text-cream underline decoration-line-hi underline-offset-4 hover:text-brass-hi">
                {empresa.contacto}
              </a>
            </p>
          )
        }
        <p class="mt-3 text-sm text-muted">
          {footer.ventureAntes}{' '}
          <a href={empresa.venture.url} rel="noopener" target="_blank" class="text-cream underline decoration-line-hi underline-offset-4 hover:text-brass-hi">
            {empresa.venture.nombre}<span class="sr-only"> (se abre en una pestaña nueva)</span>
          </a>.
        </p>
      </div>

      {
        footer.columnas.map((columna) => (
          <nav aria-label={columna.titulo}>
            <p class="font-mono text-[0.6875rem] tracking-[0.16em] text-brass uppercase">{columna.titulo}</p>
            <ul class="mt-4 flex flex-col gap-2.5">
              {columna.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-muted transition-colors duration-200 hover:text-cream">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-line pt-6 md:flex-row md:items-start md:justify-between">
      <div class="flex flex-col gap-2">
        {
          legales.length > 0 && (
            <dl class="flex flex-wrap gap-x-6 gap-y-1 text-[0.8125rem]" data-legal>
              {legales.map((l) => (
                <div class="flex gap-1.5">
                  <dt class="text-muted">{l.rotulo}:</dt>
                  <dd class="text-cream">{l.valor}</dd>
                </div>
              ))}
            </dl>
          )
        }
        <p class="max-w-2xl text-[0.8125rem] text-muted">{footer.nota}</p>
      </div>
      <p class="shrink-0 font-mono text-[0.8125rem] text-muted">{footer.copyright}</p>
    </div>
  </div>
</footer>
